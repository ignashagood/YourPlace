<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RoundedDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/guest_count_picker_dialog_background
        </item> <!-- Фон с закругленными углами -->
    </style>

    <style name="AuthTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_color</item>
        <item name="boxBackgroundColor">#00000000</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="hintTextColor">@color/white</item>
        <item name="hintTextAppearance">@style/AuthTextAppearance</item>
        <item name="android:textColor">@color/white</item>
        <item name="cursorColor">@color/white</item>
    </style>

    <style name="PickerTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/picker_box_color</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="hintTextColor">@color/white</item>
        <item name="startIconTint">@color/white</item>
        <item name="hintTextAppearance">@style/PickerTextAppearance</item>
        <item name="android:textColor">@color/white</item>
        <item name="cursorColor">@color/white</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
    </style>

    <style name="AuthTextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>

    <style name="PickerTextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>

    <style name="TableTextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/montserrat</item>
    </style>
</resources>